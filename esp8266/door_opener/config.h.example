#pragma once

constexpr char WIFI_SSID[] = "replace-with-wifi-name";
constexpr char WIFI_PASSWORD[] = "replace-with-wifi-password";
constexpr char DEVICE_HOSTNAME[] = "door-opener";

// Prefer Home Assistant's fixed IP address. .local hostnames require mDNS
// support and may not resolve reliably in every ESP8266 setup.
constexpr char HOME_ASSISTANT_WEBHOOK_URL[] =
    "http://homeassistant.local:8123/api/webhook/replace-webhook-id";
constexpr char READING_WEBHOOK_URL[] =
    "http://homeassistant.local:8123/api/webhook/replace-reading-webhook-id";

// NodeMCU A0 readings are normally 0-1023. Calibrate this using the serial
// monitor with the LDR in both relevant light conditions.
constexpr unsigned long ACTIVATION_THRESHOLD = 512;
constexpr unsigned long RETRY_TIMEOUT_MS = 5000;
constexpr unsigned long WIFI_CONNECT_TIMEOUT_MS = 20000;
